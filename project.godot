; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Elemental Duel"
config/description="1v1 elemental wizard duel"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/core/game.gd"
Sfx="*res://scripts/core/sfx.gd"
Net="*res://scripts/net/net.gd"
Perf="*res://scripts/core/perf.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="wizards"
3d_physics/layer_3="spells"
3d_physics/layer_4="walls"
3d_physics/layer_5="boundary"
3d_physics/layer_6="camera_block"

[rendering]

renderer/rendering_method="gl_compatibility"
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
anti_aliasing/quality/msaa_3d=2
